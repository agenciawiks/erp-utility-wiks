# Configurações do Firebase para o Gerador de Estampas
# Copie este arquivo para um arquivo chamado `.env` na raiz do projeto e preencha com as suas credenciais.

VITE_FIREBASE_API_KEY=seu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu_auth_domain_aqui
VITE_FIREBASE_PROJECT_ID=seu_project_id_aqui
VITE_FIREBASE_STORAGE_BUCKET=seu_storage_bucket_aqui
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_messaging_sender_id_aqui
VITE_FIREBASE_APP_ID=seu_app_id_aqui

# Token do GitHub pra api/export-erp.js exportar produto salvo pro Wiks Brain
# (repo agenciawiks/guilherme). Fine-grained PAT, só nesse repo, permissão
# "Contents: Read and write". NUNCA prefixar com VITE_ (ficaria exposto no
# bundle do navegador) — essa variável só é lida no servidor (api/).
GITHUB_TOKEN=seu_personal_access_token_aqui
